load(
    "@rules_graalvm//graalvm:defs.bzl",
    "native_image",
    "native_image_layer",
)
load("@rules_java//java:defs.bzl", "java_binary")

ENTRY = "exe.Main"

native_image_layer(
    name = "libbase",
    directives = ["package=base"],
    deps = ["//sample/base"],
)

java_binary(
    name = "mainjvm",
    main_class = ENTRY,
    runtime_deps = ["//sample/base"],
)

native_image(
    name = "main",
    layers = [":libbase"],
    main_class = ENTRY,
    deps = ["//sample/exe"],
)

alias(
    name = "sample",
    actual = "main",
)
