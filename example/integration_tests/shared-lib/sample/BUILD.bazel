load(
    "@rules_graalvm//graalvm:defs.bzl",
    "native_image",
)
load("@rules_java//java:java_library.bzl", "java_library")

java_library(
    name = "java",
    srcs = ["Main.java"],
)

native_image(
    name = "lib-native",
    shared_library = True,
    deps = [":java"],
)

alias(
    name = "sample",
    actual = "lib-native",
)
