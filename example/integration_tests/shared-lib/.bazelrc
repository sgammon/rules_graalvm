build --enable_bzlmod

# Compile against GraalVM's JDK: the sample's @CEntryPoint imports need the `org.graalvm.nativeimage`
# module, and the graalvm/jvm toolchains are gated on this version. Run javac on a hermetic JDK, not
# the host JDK; GitHub runners now ship JDK 25, which a JDK 21 javac cannot target.
build --java_runtime_version=graalvm_21
build --tool_java_runtime_version=remotejdk_21
