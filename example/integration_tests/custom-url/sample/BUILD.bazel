load(
    "@rules_graalvm//graalvm:defs.bzl",
    "native_image",
)
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

# The MODULE.bazel declares `url_per_platform` entries for linux-x64, linux-aarch64,
# macos-aarch64, and windows-x64. GraalVM CE 25.0.2 does not ship a macos-x64 build, so that
# host is intentionally excluded — a `bazelisk build` on macos-x64 will fail during repo fetch
# with a clear "no entry for macos-x64" diagnostic from the rule.

java_library(
    name = "java",
    srcs = ["Main.java"],
)

java_binary(
    name = "mainjvm",
    main_class = "Main",
    runtime_deps = [":java"],
)

native_image(
    name = "main-native",
    main_class = "Main",
    deps = [":java"],
)

alias(
    name = "sample",
    actual = "main-native",
)
