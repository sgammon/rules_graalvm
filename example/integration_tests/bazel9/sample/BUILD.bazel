load(
    "@rules_graalvm//graalvm:defs.bzl",
    "native_image",
)
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "java",
    srcs = ["Main.java"],
)

java_binary(
    name = "main",
    main_class = "Main",
    runtime_deps = [
        ":java",
    ],
)

cc_library(
    name = "native_support",
    srcs = ["native_support.c"],
    linkstatic = True,
)

filegroup(
    name = "configuration",
    srcs = ["configuration/reflect-config.json"],
)

native_image(
    name = "main-native",
    cc_deps = [":native_support"],
    configuration_file_directories = [":configuration"],
    emit_intermediate_dir = True,
    main_class = "Main",
    relocate_polyglot_cache = True,
    deps = [":java"],
)

alias(
    name = "sample",
    actual = "main-native",
)
