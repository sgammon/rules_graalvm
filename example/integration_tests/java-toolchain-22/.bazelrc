build --extra_toolchains=@graalvm//:toolchain
build --extra_toolchains=@graalvm//:toolchain_gvm
build --extra_toolchains=@graalvm//:bootstrap_runtime_toolchain

build --tool_java_language_version=22
build --tool_java_runtime_version=graalvm_22
build --java_language_version=22
build --java_runtime_version=graalvm_22
