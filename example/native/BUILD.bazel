load(
    "@rules_graalvm//graalvm:defs.bzl",
    "native_image",
)
load(
    "@rules_java//java:defs.bzl",
    "java_binary",
    "java_library",
    "java_test",
)

package(default_visibility = [
    "//tests:__subpackages__",
])

java_library(
    name = "java",
    srcs = ["Main.java"],
)

java_binary(
    name = "main",
    main_class = "Main",
    runtime_deps = [
        ":java",
    ],
)

native_image(
    name = "main-native",
    main_class = "Main",
    deps = [":java"],
)

alias(
    name = "native",
    actual = "main-native",
)

native_image(
    name = "image_directory",
    executable_name = "hello",
    extra_args = [
        "-H:+UnlockExperimentalVMOptions",
        "-H:+GenerateBuildArtifactsFile",
        "-H:-UnlockExperimentalVMOptions",
    ],
    main_class = "Main",
    output_directory = True,
    deps = [":java"],
)

java_test(
    name = "image_directory_test",
    srcs = ["ImageDirectoryTest.java"],
    args = ["$(rootpath :image_directory)"],
    data = [":image_directory"],
    main_class = "ImageDirectoryTest",
    use_testrunner = False,
)
