"Defines settings targets for Native Image builds."

load(
    "@bazel_skylib//rules:common_settings.bzl",
    "string_flag",
)
load(
    "@rules_java//java:defs.bzl",
    "java_binary",
)
load(
    "//internal/native_image:settings.bzl",
    "DEFAULTS",
    "GraalVMCompilerBackend",
    "GraalVMLibC",
    "native_image_info",
    "native_image_settings",
)

package(default_visibility = [
    "//visibility:public",
])

exports_files([
    "builder.bzl",
    "classic.bzl",
    "common.bzl",
    "rules.bzl",
    "settings.bzl",
    "toolchain.bzl",
])

string_flag(
    name = "libc",
    build_setting_default = DEFAULTS.LIBC,
    values = [
        GraalVMLibC.GLIBC,
        GraalVMLibC.MUSL,
    ],
)

string_flag(
    name = "compiler_backend",
    build_setting_default = DEFAULTS.COMPILER_BACKEND,
    values = [
        GraalVMCompilerBackend.NATIVE,
        GraalVMCompilerBackend.LLVM,
    ],
)

native_image_info(
    name = "settings",
    compiler_backend = ":compiler_backend",
    libc = ":libc",
)

native_image_settings(
    name = "defaults",
    compiler_backend = DEFAULTS.COMPILER_BACKEND,
    libc = DEFAULTS.LIBC,
    opt = DEFAULTS.BUILD_OPT,
)

# Runs native-image with the C toolchain's sysroot made absolute: native-image calls the C compiler from its
# own temporary directory, so an exec-root-relative sysroot cannot be passed as it is.
java_binary(
    name = "sysroot_launcher",
    srcs = ["SysrootLauncher.java"],
    main_class = "build.bazel.rules_graalvm.SysrootLauncher",
)
